{
  "openapi": "3.0.0",
  "info": {
    "title": "KDex Host: gen-v1-events",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/events": {
      "get": {
        "operationId": "gen-v1-events-get",
        "description": "GET /v1/events",
        "responses": {
          "200": {
            "description": "Typed server-sent events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Update"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [
              "functions:/v1/events:read"
            ]
          }
        ]
      }
    },
    "/v1/events/raw": {
      "get": {
        "operationId": "gen-v1-events-raw-get",
        "description": "GET /v1/events/raw",
        "responses": {
          "200": {
            "description": "Untyped server-sent events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [
              "functions:/v1/events:read"
            ]
          }
        ]
      }
    },
    "/v1/status": {
      "get": {
        "operationId": "gen-v1-status-get",
        "description": "GET /v1/status",
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Update"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [
              "functions:/v1/events:read"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Update": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "format": "JWT"
      }
    }
  }
}
