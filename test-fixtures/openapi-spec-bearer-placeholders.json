{
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "format": "JWT"
      }
    }
  },
  "info": {
    "description": "Requirement placeholders bound per request (kdex-tech/fngogen#15)",
    "title": "KDex Host: gen-v1-roles",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/v1/roles/{key}": {
      "put": {
        "operationId": "gen-v1-roles-key-put",
        "parameters": [
          {
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Updated"
          }
        },
        "security": [
          {
            "bearer": [
              "roles:{key}:update"
            ]
          }
        ]
      }
    },
    "/v1/roles/{key}/members/{id}": {
      "put": {
        "operationId": "gen-v1-roles-key-members-id-put",
        "parameters": [
          {
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Added"
          }
        },
        "security": [
          {
            "bearer": [
              "roles:{key}:update",
              "users:{id}:update_roles"
            ]
          }
        ]
      }
    },
    "/v1/stores": {
      "post": {
        "operationId": "gen-v1-stores-post",
        "parameters": [
          {
            "in": "header",
            "name": "X-Store-Id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "store",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Written"
          }
        },
        "security": [
          {
            "bearer": [
              "stores:{store}:write"
            ]
          }
        ],
        "x-entitlement-binding": {
          "store": [
            {
              "in": "header",
              "name": "X-Store-Id"
            },
            {
              "in": "query",
              "name": "store"
            }
          ]
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://sim.test"
    }
  ]
}
