{
  "openapi": "3.0.0",
  "info": {
    "title": "KDex Host: gen-v1-files",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/files/{id}": {
      "get": {
        "operationId": "gen-v1-files-id-get",
        "description": "GET /v1/files/{id}",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File bytes",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/v1/files": {
      "get": {
        "operationId": "gen-v1-files-get",
        "description": "GET /v1/files",
        "responses": {
          "200": {
            "description": "File list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
