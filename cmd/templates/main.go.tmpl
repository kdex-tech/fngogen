func (s *security) handleApiKey(ctx context.Context, operationName api.OperationName, scheme string, tokenString string, roles []string) (context.Context, error) {
	// White-label: the host may have replaced the PASETO "v4.public." header
	// with its brand prefix (PASETO_TOKEN_PREFIX). Restore the header before
	// parsing so the signature verifies. A token that already starts with
	// "v4.public." is bare and left untouched; anything else carrying the
	// configured prefix has it swapped back for the header.
	if s.tokenPrefix != "" && !strings.HasPrefix(tokenString, "v4.public.") && strings.HasPrefix(tokenString, s.tokenPrefix) {
		tokenString = "v4.public." + tokenString[len(s.tokenPrefix):]
	}

	parser := paseto.NewParser()
	footerBytes, err := parser.UnsafeParseFooter(paseto.V4Public, tokenString)
	if err != nil {
		return nil, fmt.Errorf("invalid token footer: %w", err)
	}

	var footerData struct {
		KID string `json:"kid"`
	}
	if err := json.Unmarshal(footerBytes, &footerData); err != nil {
		return nil, fmt.Errorf("invalid footer JSON: %w", err)
	}

	pubKey, ok := s.pks.Get(footerData.KID)
	if !ok {
		return nil, fmt.Errorf("unknown key ID: %s", footerData.KID)
	}

	parser.AddRule(paseto.NotExpired())
	parser.AddRule(paseto.ValidAt(time.Now()))
	parser.AddRule(paseto.ForAudience(s.audience))
	parser.AddRule(paseto.IssuedBy(s.issuer))

	token, err := parser.ParseV4Public(*pubKey, tokenString, nil)
	if err != nil {
		return nil, fmt.Errorf("failed to validate PASETO: %w", err)
	}

	claims := jwt.MapClaims{}
	for k, v := range token.Claims() {
		claims[k] = v
	}

	return s.hasValidClaims(ctx, "scp", scheme, roles, claims)
}
