func (s *security) hasValidClaims(
	ctx context.Context, claim string, scheme string, requirements []string, claims jwt.MapClaims,
) (context.Context, error) {
	if claims == nil {
		return nil, fmt.Errorf("missing required claims")
	}

	if s.debug {
		fmt.Println("[DEBUG] claims", claims)
	}

	_, ok := claims["sub"].(string)
	if !ok {
		return nil, fmt.Errorf("missing required claim: sub")
	}

	var claimValues []string
	claimValuesRaw, ok := claims[claim]

	if !ok {
		return nil, fmt.Errorf("missing required claim: %s", claim)
	}

	switch v := claimValuesRaw.(type) {
	case string:
		claimValues = strings.Fields(v)
	case []string:
		claimValues = v
	case []any:
		claimValues = make([]string, 0, len(v))
		for _, e := range v {
			if s, ok := e.(string); ok {
				claimValues = append(claimValues, strings.TrimSpace(s))
			}
		}
	default:
		return nil, fmt.Errorf("unknown assertion type: %T for claim: %s", v, claim)
	}

	ent := entitlements.Entitlements{
		scheme: claimValues,
	}
	req := entitlements.Requirements{
		map[string][]string{
			scheme: requirements,
		},
	}

	// Bind each {placeholder} to the instance this request addresses before
	// verifying: unbound, it is a literal only a held wildcard satisfies. An
	// unresolved placeholder refuses the request. See bindRequestPlaceholders.
	binding, ok := ctx.Value(bindingContextKey{}).(entitlements.Binding)
	bound, err := s.checker.BindRequirements(s.checker.ParseRequirements(req), binding)
	if err != nil && !ok {
		// No binding on the context at all: the request never passed through
		// bindRequestPlaceholders. A custom ServerConfig that replaces
		// srv.Handler instead of wrapping it does exactly that.
		return nil, fmt.Errorf("requirements %v not bound: no request binding (is srv.Handler wrapped, not replaced?): %w", req, err)
	}
	if err != nil {
		return nil, fmt.Errorf("requirements %v not bound for this request: %w", req, err)
	}

	if s.debug {
		fmt.Println("[DEBUG] entitlements", ent)
		fmt.Println("[DEBUG] requirements", req, "binding", binding)
	}

	if !s.checker.VerifyParsedEntitlements(s.checker.ParseEntitlements(ent), bound) {
		return nil, fmt.Errorf("entitlements %v do not match requirements %v bound to %v", ent, req, binding)
	}

	return s.mergeClaims(ctx, claims), nil
}

func (s *security) mergeClaims(ctx context.Context, newClaims jwt.MapClaims) context.Context {
	claims, ok := ctx.Value(UserContextKey).(jwt.MapClaims)
	if !ok {
		claims = jwt.MapClaims{}
	}
	for k, v := range newClaims {
		if existingSlice, isSlice := claims[k].([]string); isSlice {
			if newSlice, ok := v.([]string); ok {
				claims[k] = append(existingSlice, newSlice...)
				continue
			}
		}
		claims[k] = v
	}
	return context.WithValue(ctx, UserContextKey, claims)
}
{{end}}
